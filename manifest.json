{
  "schemaVersion": 1,
  "id": "foamy.vitals",
  "name": "Foamy Vitals",
  "version": "1.0.0",
  "author": "foamrider",
  "description": "System activity, memory, graphics and temperatures",
  "license": "MIT",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Vitals",
    "description": "System activity and hardware readings",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "language": "system",
      "barDisplay": "adaptive",
      "cpuWarning": 95,
      "memoryWarning": 95,
      "gpuWarning": 95,
      "vramWarning": 95,
      "cpuTemperatureMargin": 15,
      "gpuTemperatureMargin": 15
    },
    "schema": [
      {
        "key": "language",
        "type": "enum",
        "label": "Language",
        "defaultValue": "system",
        "options": [
          "system",
          "en",
          "nb"
        ]
      },
      {
        "key": "barDisplay",
        "type": "enum",
        "label": "Bar display",
        "defaultValue": "adaptive",
        "options": [
          "adaptive",
          "cpu",
          "memory",
          "gpu"
        ]
      },
      {
        "key": "cpuWarning",
        "type": "integer",
        "label": "Usage warnings · CPU (%)",
        "defaultValue": 95,
        "min": 1,
        "max": 100,
        "step": 1
      },
      {
        "key": "memoryWarning",
        "type": "integer",
        "label": "Usage warnings · RAM (%)",
        "defaultValue": 95,
        "min": 1,
        "max": 100,
        "step": 1
      },
      {
        "key": "gpuWarning",
        "type": "integer",
        "label": "Usage warnings · GPU (%)",
        "defaultValue": 95,
        "min": 1,
        "max": 100,
        "step": 1
      },
      {
        "key": "vramWarning",
        "type": "integer",
        "label": "Usage warnings · VRAM (%)",
        "defaultValue": 95,
        "min": 1,
        "max": 100,
        "step": 1
      },
      {
        "key": "cpuTemperatureMargin",
        "type": "integer",
        "label": "Temperature warnings · below limit · CPU (°C)",
        "defaultValue": 15,
        "min": 0,
        "max": 100,
        "step": 1
      },
      {
        "key": "gpuTemperatureMargin",
        "type": "integer",
        "label": "Temperature warnings · below limit · GPU (°C)",
        "defaultValue": 15,
        "min": 0,
        "max": 100,
        "step": 1
      }
    ]
  }
}
